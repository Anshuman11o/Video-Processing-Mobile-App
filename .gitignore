# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.jks
credentials.json
secrets.json
service-account*.json
*-credentials.json
aws-credentials
.aws/

# API keys and tokens
*.secret
*.secrets
api_keys.json
tokens.json

# Terraform state (contains secrets)
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# Agent worktree state. .claude/worktrees/ holds whole checkouts of other
# branches, so committing this directory would vendor a second copy of the repo
# into the repo.
.claude/

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Scratch worktrees created by background agents. Committed agent config
# (.claude/settings.json, skills) is still tracked.
.claude/worktrees/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# React Native
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/build/
mobile/android/local.properties
mobile/android/*.keystore
!mobile/android/debug.keystore
mobile/ios/Pods/
mobile/ios/build/
mobile/ios/*.xcworkspace
mobile/ios/*.pbxuser
mobile/ios/*.mode1v3
mobile/ios/*.mode2v3
mobile/ios/*.perspectivev3
mobile/ios/xcuserdata/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Go
backend/bin/
backend/vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Local SQLite queue (runtime state, not source)
data/
*.db
*.db-wal
*.db-shm

# Speech model downloaded on demand for MOCK_TRANSCRIBE=false (hundreds of MB)
models/

# Logs
*.log
logs/

# Test coverage
coverage/
*.lcov
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Build artifacts
dist/
build/
out/

# Video files (large, not for git)
*.mp4
*.mov
*.avi
*.mkv
*.webm

# ...except documentation assets, which are deliberately committed so the
# README is self-contained. Test clips and pipeline output stay ignored by the
# rules above; this exception is scoped to one directory on purpose, so a stray
# 500 MB source video cannot be added by accident.
!docs/assets/*.mp4
!docs/assets/*.gif
*.m3u8
# HLS transport-stream segments. Scoped to output dirs so this does not
# swallow TypeScript sources (mobile/src/**/*.ts).
hls/**/*.ts
**/hls-output/**/*.ts
segments/**/*.ts
!test-fixtures/

# FFmpeg outputs
*.wav
*.aac
*.vtt
*.srt
