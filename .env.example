# DayReel Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# AWS Configuration (for real AWS deployment)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# LocalStack (for local development)
LOCALSTACK_ENDPOINT=http://localhost:4566
USE_LOCALSTACK=true

# S3 Buckets
S3_RAW_BUCKET=dayreel-raw-videos
S3_PROCESSED_BUCKET=dayreel-processed
S3_HLS_BUCKET=dayreel-hls-output

# SQS Queues
SQS_VALIDATE_QUEUE=dayreel-validate
SQS_EXTRACT_QUEUE=dayreel-extract
SQS_TRANSCRIBE_QUEUE=dayreel-transcribe
SQS_PACKAGE_QUEUE=dayreel-package
SQS_DLQ=dayreel-dlq

# DynamoDB
DYNAMODB_TABLE=dayreel-jobs

# Redis
REDIS_URL=localhost:6379

# API Server
API_PORT=8080

# Worker Configuration
MOCK_TRANSCRIBE=false
WORKER_CONCURRENCY=2

# CloudFront (for production)
CLOUDFRONT_DOMAIN=
