# DayReel Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# AWS Configuration
# REQUIRED — these are no longer optional. There is no local AWS emulator any
# more; S3 and DynamoDB calls go to a real AWS account. Use an IAM user scoped
# to the three buckets and the one table below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3 Buckets
S3_RAW_BUCKET=dayreel-raw-videos
S3_PROCESSED_BUCKET=dayreel-processed
S3_HLS_BUCKET=dayreel-hls-output

# DynamoDB
DYNAMODB_TABLE=dayreel-jobs

# Queue Names
# The pipeline routes on these names. They are values of the `queue` column in
# the local SQLite queue, not SQS queues — no AWS service is involved. They
# mirror the constants in backend/internal/events/messages.go.
QUEUE_VALIDATE=dayreel-validate
QUEUE_EXTRACT=dayreel-extract
QUEUE_TRANSCRIBE=dayreel-transcribe
QUEUE_PACKAGE=dayreel-package
QUEUE_DLQ=dayreel-dlq

# Queue Engine (self-hosted SQLite queue)
# Path to the queue database. Created on first start; delete it with
# `make queue-reset`. Keep it out of git — .gitignore covers data/.
QUEUE_DB_PATH=./data/queue.db
# How long a claimed message stays invisible to other workers. On expiry the
# message becomes claimable again on its own; nothing sweeps it.
QUEUE_VISIBILITY_TIMEOUT=5m
# Delivery attempts before a message is moved to QUEUE_DLQ.
QUEUE_MAX_DELIVERIES=3
# How often an idle worker re-checks for claimable messages. SQLite has no
# long-poll, so this is the latency/CPU trade-off knob.
QUEUE_POLL_INTERVAL=250ms

# API Server
API_PORT=8080

# Worker Configuration
MOCK_TRANSCRIBE=false
WORKER_CONCURRENCY=2

# HLS Delivery
# Reels are served directly from the HLS bucket — no CDN. The bucket must be
# readable by the player.
HLS_BASE_URL=https://dayreel-hls-output.s3.us-east-1.amazonaws.com
